# ClickHouse connection (same as dbt-cerebro and cerebro-api)
CLICKHOUSE_HOST=ujt1j3jrk0.eu-central-1.aws.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your_password_here
CLICKHOUSE_SECURE=True

# dbt manifest source (URL takes precedence over local path)
DBT_MANIFEST_URL=https://gnosischain.github.io/dbt-cerebro/manifest.json
# DBT_MANIFEST_PATH=./manifest.json

# dbt catalog source
DBT_CATALOG_URL=https://gnosischain.github.io/dbt-cerebro/catalog.json
# DBT_CATALOG_PATH=./catalog.json

# semantic artifacts and deployment gating
# False: semantic tools/resources are not registered.
# True: semantic tools/resources are registered; execution requires a healthy snapshot.
SEMANTIC_ENABLED=False
SEMANTIC_REGISTRY_URL=https://gnosischain.github.io/dbt-cerebro/semantic_registry.json
# SEMANTIC_REGISTRY_PATH=./semantic_registry.json
SEMANTIC_DOCS_INDEX_URL=https://gnosischain.github.io/dbt-cerebro/semantic_docs_index.json
# SEMANTIC_DOCS_INDEX_PATH=./semantic_docs_index.json
SEMANTIC_REFRESH_INTERVAL_SECONDS=300
# Used only for raw SQL fallback guidance and advanced research prompts.
# `get_clickhouse_query_rules` is registered only when this path contains a valid vendored bundle manifest.
CLICKHOUSE_AGENT_SKILLS_PATH=src/cerebro_mcp/static/clickhouse_agent_skills

# Safety limits
MAX_ROWS=10000
CLICKHOUSE_VERIFY=True
CLICKHOUSE_CONNECT_TIMEOUT=30
CLICKHOUSE_SEND_RECEIVE_TIMEOUT=300
CLICKHOUSE_QUERY_TIMEOUT_SECONDS=30
QUERY_TIMEOUT_SECONDS=30
MAX_QUERY_LENGTH=10000
TOOL_RESULT_MAX_ROWS=200
TOOL_RESULT_MAX_CHARS=40000
TOOL_SUMMARY_BUDGET_RATIO=0.9
ASYNC_RESULT_PAGE_SIZE=200
ASYNC_RESULT_MEMORY_THRESHOLD_BYTES=5000000
ASYNC_RESULT_DIR=.cerebro/query_results
CEREBRO_RESEARCH_DIR=.cerebro/research_projects
RESEARCH_PAGE_SIZE_DEFAULT=20
RESEARCH_PAGE_SIZE_MAX=100
ALLOW_INSECURE_REMOTE_TRANSPORT=False

# Thinking / tracing
THINKING_MODE_ENABLED=True
THINKING_ALWAYS_ON=True
THINKING_LOG_DIR=.cerebro/logs
THINKING_LOG_RETENTION_DAYS=30

# Remote transport auth
# MCP_AUTH_TOKEN=replace_me

# --- Web3 RPC / ABI ---
GNOSIS_RPC_URL=https://rpc.gnosischain.com
GNOSIS_ARCHIVE_RPC_URL=
BLOCKSCOUT_API_BASE_URL=https://gnosis.blockscout.com/api/v2
RPC_TIMEOUT_SECONDS=15
RPC_MAX_RETRIES=3
ABI_CACHE_TTL_SECONDS=3600
ABI_CACHE_MAX_ENTRIES=512

# --- Grafana dashboard publishing (opt-in) ---
# When False, the Grafana tools are not registered at all. Set to True and
# fill URL + token + datasource UID to enable publish/validate/get tools.
GRAFANA_TOOLS_ENABLED=False
GRAFANA_URL=
GRAFANA_API_TOKEN=
GRAFANA_CLICKHOUSE_DATASOURCE_UID=
GRAFANA_CLICKHOUSE_DATASOURCE_TYPE=grafana-clickhouse-datasource
# Leave blank to publish to the default (General) folder.
GRAFANA_FOLDER_UID=
GRAFANA_REQUEST_TIMEOUT_SECONDS=20
GRAFANA_SCHEMA_VERSION=41
GRAFANA_MIN_REFRESH_SECONDS=60
GRAFANA_MAX_PANELS=30
